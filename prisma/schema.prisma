generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 Int                @id @default(autoincrement())
  username           String             @unique
  password           String
  name               String
  role               String             @default("employee")
  isActive           Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  managerId          Int?
  bizName1           String?
  bizName2           String?
  allowedMenus       String?
  googleEmail        String?
  googleCalendarId   String?
  clients            Client[]
  distributions      Distribution[]     @relation("distributions")
  distributionPasses DistributionPass[] @relation("distributionPasses")
  feedbacks          Feedback[]         @relation("feedbacks")
  knowledges         Knowledge[]        @relation("knowledges")
  memos              Memo[]
  notices            Notice[]           @relation("notices")
  schedules          Schedule[]
  settings           Settings?
  assignedTasks      Task[]             @relation("assignedTasks")
  createdTasks       Task[]             @relation("createdTasks")
  telegramUsers      TelegramUser[]
  slackUsers         SlackUser[]
  manager            User?              @relation("ManagerEmployees", fields: [managerId], references: [id])
  employees          User[]             @relation("ManagerEmployees")
  bookmarks          Bookmark[]         @relation("bookmarks")
  createdBookmarks   Bookmark[]         @relation("createdBookmarks")
  rejectedReports    IncomeTaxRejection[]    @relation("rejectedReports")
  analyzedAnalyses   ClientNoticeAnalysis[]  @relation("analyzedAnalyses")
  revertedReports    IncomeTaxRevertHistory[] @relation("revertedReports")
  collectionContacts CollectionContact[]     @relation("collectionContacts")
  vatRejections      VatRejection[]          @relation("vatRejectedReports")
}

model Client {
  id                        Int                        @id @default(autoincrement())
  name                      String
  bizNumber                 String?
  ceoName                   String?
  phone                     String?
  email                     String?
  address                   String?
  bizType                   String?
  bizCategory               String?
  bizItem                   String?
  clientType                String                     @default("individual")
  contractStatus            String                     @default("active")
  terminationMonth          String?
  paymentMethod             String                     @default("cms")
  taxationType              String?
  vatTypeDetail             String?  // 홈택스 신고리스트 '과세유형 상세' (부가세 페이지 업로드로 갱신)
  taxTypes                  String?
  laborTypes                String?
  laborOfficeManaged        Boolean                    @default(false) // 4대보험을 노무사사무실이 관리 → 신규수임 EDI 체크 생략
  residentNumber            String?
  hometaxId                 String?
  hometaxPw                 String?
  monthlyFee                Int?
  firstWithdrawalMonth      String?
  withdrawalDay             Int?                       // 월 출금일(1~31). 미설정 시 소속 기본값(세이브택스 5일 / 세무회계태호 25일)
  billingTiming             String?                    // 수납방식 "same"(당월수납)|"arrears"(후불). 미설정 시 소속 기본값
  bankName                  String?
  bankAccount               String?
  notes                     String?
  assignedUserId            Int?
  subAssignedUserId         Int?
  isDeleted                 Boolean                    @default(false)
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  corporateNumber           String?
  openDate                  String?
  contractDate              String?
  halfYearTax               Boolean                    @default(false)
  affiliation               String?
  cmsAffiliation            String?
  freeMonths                Int?
  myboxLink                 String?
  accountingProgram         String                     @default("위하고")
  cmsStatus                 String                     @default("none")
  contactMethod             String                     @default("카톡")
  driveFolderId             String?
  withholdingDNotified      Boolean                    @default(false)
  withholdingType           String?
  wehagoCdCom               String?
  wehagoCno                 String?
  wehagoColors              String?
  assignedUser              User?                      @relation(fields: [assignedUserId], references: [id])
  commission                CommissionProcess?
  termination               TerminationProcess?
  dataCollections           DataCollection[]
  feeRecords                FeeRecord[]
  incomeTaxRecords          IncomeTaxRecord[]
  memos                     Memo[]
  tasks                     Task[]
  withholdingLaborOverrides WithholdingLaborOverride[]
  withholdingProcesses      WithholdingProcess[]
  withholdingRecords        WithholdingRecord[]
  insuranceReports          InsuranceReport[]
  unpaidPostpone            UnpaidPostpone?
  alimtalkLogs              AlimtalkLog[]
  incomeTaxRejections       IncomeTaxRejection[]
  noticeAnalyses            ClientNoticeAnalysis[]
  incomeTaxRevertHistories  IncomeTaxRevertHistory[]
  vatRecords                VatRecord[]
  vatRejections             VatRejection[]
  collectionContacts        CollectionContact[]
}

model CollectionContact {
  id              Int      @id @default(autoincrement())
  clientId        Int
  contactedAt     DateTime @default(now())
  result          String   // "promise" | "absent" | "bluff" | "other"
  promiseDate     String?  // 상환약속일 "YYYY-MM-DD" (result=promise)
  memo            String?
  createdByUserId Int?
  createdAt       DateTime @default(now())
  client          Client   @relation(fields: [clientId], references: [id])
  createdByUser   User?    @relation("collectionContacts", fields: [createdByUserId], references: [id])

  @@index([clientId, contactedAt])
}

model AlimtalkLog {
  id           Int      @id @default(autoincrement())
  clientId     Int
  type         String
  status       String   @default("sent")
  sentAt       DateTime @default(now())
  sentByUserId Int?
  errorMsg     String?
  client       Client   @relation(fields: [clientId], references: [id])

  @@index([clientId, type, sentAt])
}

model FeeRecord {
  id        Int      @id @default(autoincrement())
  clientId  Int
  yearMonth String
  status    String   @default("unpaid")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  client    Client   @relation(fields: [clientId], references: [id])

  @@unique([clientId, yearMonth])
}

model Task {
  id                  Int       @id @default(autoincrement())
  clientId            Int?
  assignedUserId      Int?
  title               String
  taskType            String?
  status              String    @default("scheduled")
  priority            String    @default("normal")
  dueDate             DateTime?
  completedAt         DateTime?
  notes               String?
  isDeleted           Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  createdByUserId     Int?
  sharedWithEmployees Boolean   @default(false)
  memos               Memo[]
  assignedUser        User?     @relation("assignedTasks", fields: [assignedUserId], references: [id])
  client              Client?   @relation(fields: [clientId], references: [id])
  createdByUser       User?     @relation("createdTasks", fields: [createdByUserId], references: [id])
}

model Settings {
  id                 Int     @id @default(autoincrement())
  agentHometaxId     String?
  agentHometaxPw     String?
  certName           String?
  certPassword       String?
  commissionFormPath String?
  agentIdCardPath    String?
  userId             Int     @unique
  cmsExcelPath       String?
  cmsExcelPersonalPath String?
  cmsBulkExcelPath   String?
  cmsInstantExcelPath String?
  healthExcelPath    String?
  pensionExcelPath   String?
  tiBulkExcelPath    String?
  tiNormalExcelPath  String?
  tiSupplierBizNum   String?
  tiSupplierName     String?
  tiSupplierCeoName  String?
  wehagoId           String?
  wehagoPw           String?
  wehagoTaxNum       String?
  wemembersId        String?
  wemembersPw        String?
  agentNumber        String?
  alimtalkHappyCallIndiv  String?
  alimtalkHappyCallCorp   String?
  alimtalkDocRemind       String?
  alimtalkFeeRemind       String?
  taxReductionExcelPath   String?
  slackMorningEnabled     Boolean @default(true)
  slackMorningTime        String  @default("08:00")
  slackEveningEnabled     Boolean @default(true)
  slackEveningTime        String  @default("19:00")
  slackDistributionEnabled Boolean @default(true)
  driveBasePath           String?
  user               User    @relation(fields: [userId], references: [id])
}

model CommissionProcess {
  id                    Int         @id @default(autoincrement())
  clientId              Int         @unique
  hasIdCard             Boolean     @default(false)
  hasHometaxCredentials Boolean     @default(false)
  hometaxCommissionDone Boolean     @default(false)
  hometaxCommissionAt   DateTime?
  semoReportDone        Boolean     @default(false)
  semoReportAt          DateTime?
  wememberDone          Boolean     @default(false) // 위멤버스 등록
  wememberAt            DateTime?
  wihagoType            String?
  wihagoDone            Boolean     @default(false)
  wihagoAt              DateTime?
  hasEmployees          Boolean     @default(false)
  nationalPensionDone   Boolean     @default(false)
  nationalPensionAt     DateTime?
  healthInsuranceDone   Boolean     @default(false)
  healthInsuranceAt     DateTime?
  idCardPath            String?
  notes                 String?
  completedAt           DateTime?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  connectedAt           DateTime?
  dataRequestCount      Int         @default(0)
  excludeConfirmed      Boolean     @default(false)
  excludeRequested      Boolean     @default(false)
  lastDataRequestAt     DateTime?
  postponeNote          String?
  postponedUntil        DateTime?
  excludeRequestedAt    DateTime?
  lastTransferRequestAt DateTime?
  transferReceivedAt    DateTime?
  transferRequested     Boolean     @default(false)
  client                Client      @relation(fields: [clientId], references: [id])
  happyCalls            HappyCall[]
}

model HappyCall {
  id           Int               @id @default(autoincrement())
  commissionId Int
  attemptNo    Int
  result       String
  notes        String?
  calledAt     DateTime          @default(now())
  commission   CommissionProcess @relation(fields: [commissionId], references: [id])
}

model WithholdingRecord {
  id        Int      @id @default(autoincrement())
  clientId  Int
  yearMonth String
  taskType  String
  done      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  client    Client   @relation(fields: [clientId], references: [id])

  @@unique([clientId, yearMonth, taskType])
}

model WithholdingProcess {
  id        Int       @id @default(autoincrement())
  clientId  Int
  yearMonth String
  step      String
  done      Boolean   @default(false)
  doneAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  client    Client    @relation(fields: [clientId], references: [id])

  @@unique([clientId, yearMonth, step])
}

model WithholdingLaborOverride {
  id         Int     @id @default(autoincrement())
  clientId   Int
  yearMonth  String
  laborTypes String?
  memo       String?
  client     Client  @relation(fields: [clientId], references: [id])

  @@unique([clientId, yearMonth])
}

// 4대보험 신고 관리 (성립/취득/상실) — 고객사수정 모달 원천세 탭
model InsuranceReport {
  id            Int      @id @default(autoincrement())
  clientId      Int
  reportType    String   // establishment(성립) | acquisition(취득) | loss(상실)
  employeeName  String?
  residentNumber String? // 주민등록번호
  workerType    String?  // 근로 | 사업 | 일용 (취득)
  insurances    String?  // 가입 보험 콤마 목록: 연금,건강,고용,산재 (취득·근로)
  baseSalary    Int?     // 기본급
  mealAllowance Int?     // 식대
  carAllowance  Int?     // 자가운전보조금
  researchAllowance Int? // 연구수당
  hireDate      String?  // 입사일 (취득)
  leaveDate     String?  // 퇴사일 (상실)
  lossReason    String?  // 상실사유 (상실)
  jobCertNeeded Boolean  @default(false) // 이직확인서 필요 (상실)
  requestedDate String?  // 대표자 요청
  requestedBy   String?
  filedDate     String?  // 실무자 신고
  filedBy       String?
  confirmedDate String?  // 확인
  confirmedBy   String?
  memo          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  client        Client   @relation(fields: [clientId], references: [id])

  @@index([clientId])
}

model TransferConfirm {
  id          Int      @id @default(autoincrement())
  driveFileId String   @unique
  fileName    String
  confirmedBy Int?
  confirmedAt DateTime @default(now())
}

model IncomeTaxRecord {
  id                Int      @id @default(autoincrement())
  clientId          Int
  taxYear           String
  bookkeepingDuty   String?
  filingType        String?
  noticeSent        Boolean  @default(false)
  linkPass          Boolean  @default(false)
  depreciation      Boolean  @default(false)
  interestExpense   Boolean  @default(false)
  insurance         Boolean  @default(false)
  donation          Boolean  @default(false)
  preSettlement     Boolean  @default(false)
  prevSales         BigInt?
  prevIncome        BigInt?
  prevTax           BigInt?
  currSales         BigInt?
  currIncome        BigInt?
  currTax           BigInt?
  bookkeepingCredit Boolean  @default(false)
  startupReduction  Boolean  @default(false)
  smeReduction      Boolean  @default(false)
  investCredit      Boolean  @default(false)
  employmentCredit  Boolean  @default(false)
  confirmStage      Boolean  @default(false)
  noticeRequestSent Boolean  @default(false)
  excluded          Boolean  @default(false)
  excludedAt        DateTime?
  excludedReason    String?
  depositReceived   Boolean  @default(false)
  filingDone        Boolean  @default(false)
  paymentSent       Boolean  @default(false)
  adjustmentFee     BigInt?
  memo              String?
  rejectionCount    Int      @default(0)
  lastRejectedAt    DateTime?
  backToCollect     Boolean  @default(false)
  onHold            Boolean  @default(false)
  cmsWithdrawn      Boolean  @default(false)
  directDeposit     Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  client            Client   @relation(fields: [clientId], references: [id])

  @@unique([clientId, taxYear])
}

model VatRecord {
  id            Int      @id @default(autoincrement())
  clientId      Int
  period        String   // "2026-1-예정" / "2026-1-확정" / "2026-2-예정" / "2026-2-확정"
  stage         String   @default("collect")  // collect→writing→approval→confirm→done
  checklist     String?                          // 단계별 체크리스트 상태 JSON {"key":true}
  stageCollect  Boolean  @default(false)  // (구) 미사용 — stage로 대체
  stageDraft    Boolean  @default(false)  // 2.신고서작성
  stageReview   Boolean  @default(false)  // 3.검토
  stageFiled    Boolean  @default(false)  // 4.신고완료
  stagePaid     Boolean  @default(false)  // 5.수금
  fee           Int?                       // 신고수수료 (기장=0 기본, 신고대리=입력)
  noticeTax     Int?                       // 예정고지세액
  excluded      Boolean  @default(false)  // 이번 기간 신고 제외
  memo          String?
  htxData       String?                    // 홈택스 부가세 신고자료 엑셀 업로드 데이터 (JSON)
  htxImportedAt DateTime?                  // 홈택스 자료 마지막 업로드 시각
  rejectionCount Int     @default(0)       // 결재 반려 누적 횟수
  lastRejectedAt DateTime?                 // 마지막 반려 시각
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  client        Client   @relation(fields: [clientId], references: [id])

  @@unique([clientId, period])
}

model VatRejection {
  id           Int       @id @default(autoincrement())
  clientId     Int
  period       String
  sequence     Int
  reason       String
  rejectedById Int
  rejectedAt   DateTime  @default(now())
  resolvedAt   DateTime?
  client       Client    @relation(fields: [clientId], references: [id])
  rejectedBy   User      @relation("vatRejectedReports", fields: [rejectedById], references: [id])

  @@index([clientId, period])
}

model IncomeTaxRevertHistory {
  id           Int      @id @default(autoincrement())
  clientId     Int
  taxYear      String
  fromStage    String
  toStage      String
  revertedById Int
  revertedAt   DateTime @default(now())
  client       Client   @relation(fields: [clientId], references: [id])
  revertedBy   User     @relation("revertedReports", fields: [revertedById], references: [id])

  @@index([clientId, taxYear])
}

model IncomeTaxRejection {
  id           Int      @id @default(autoincrement())
  clientId     Int
  taxYear      String
  sequence     Int
  reason       String
  rejectedById Int
  rejectedAt   DateTime @default(now())
  resolvedAt   DateTime?
  client       Client   @relation(fields: [clientId], references: [id])
  rejectedBy   User     @relation("rejectedReports", fields: [rejectedById], references: [id])

  @@index([clientId, taxYear])
}

model ClientNoticeAnalysis {
  id                     Int      @id @default(autoincrement())
  clientId               Int
  taxYear                String
  analyzedAt             DateTime @default(now())
  analyzedById           Int?
  pdfFileId              String?
  filingType             String?
  totalSales             BigInt?
  businessSales          BigInt?
  freelanceSales         BigInt?
  hasOtherIncome         Boolean  @default(false)
  otherIncomeFlags       String?
  incomeHistory          String?
  rawJson                String
  reviewedByStaffAt      DateTime?
  reviewedByAccountantAt DateTime?
  client                 Client   @relation(fields: [clientId], references: [id])
  analyzedBy             User?    @relation("analyzedAnalyses", fields: [analyzedById], references: [id])

  @@unique([clientId, taxYear])
}

model DataCollection {
  id        Int      @id @default(autoincrement())
  clientId  Int
  docType   String
  taxYear   String
  status    String   @default("pending")
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  params    String?
  client    Client   @relation(fields: [clientId], references: [id])

  @@unique([clientId, docType, taxYear])
}

model Schedule {
  id             Int      @id @default(autoincrement())
  userId         Int
  title          String
  date           String
  endDate        String?
  startTime      String?
  endTime        String?
  color          String   @default("blue")
  notes          String?
  googleEventId  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id])
}

model Memo {
  id        Int      @id @default(autoincrement())
  clientId  Int?
  taskId    Int?
  authorId  Int
  content   String
  memoType  String   @default("general")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  title     String?
  author    User     @relation(fields: [authorId], references: [id])
  client    Client?  @relation(fields: [clientId], references: [id])
  task      Task?    @relation(fields: [taskId], references: [id])
}

model Distribution {
  id                       Int       @id @default(autoincrement())
  clientName               String
  clientType               String
  assignedUserId           Int
  batchId                  String?
  createdAt                DateTime  @default(now())
  isSkipped                Boolean   @default(false)
  excludeReason            String?
  confirmedAt              DateTime?
  clientMissingDismissedAt DateTime?
  assignedUser             User      @relation("distributions", fields: [assignedUserId], references: [id])
}

model DistributionPass {
  id         Int    @id @default(autoincrement())
  userId     Int
  clientType String
  user       User   @relation("distributionPasses", fields: [userId], references: [id])

  @@unique([userId, clientType])
}

model Knowledge {
  id        Int      @id @default(autoincrement())
  authorId  Int
  category  String
  title     String
  content   String
  tags      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  files     String?
  author    User     @relation("knowledges", fields: [authorId], references: [id])
}

model Notice {
  id          Int      @id @default(autoincrement())
  authorId    Int
  category    String
  subCategory String?
  title       String
  content     String
  isPinned    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  author      User     @relation("notices", fields: [authorId], references: [id])
}

model TempMemo {
  id          Int      @id @default(autoincrement())
  telegramId  String   @default("")
  senderName  String
  content     String
  fileUrl     String?
  isProcessed Boolean  @default(false)
  source      String   @default("telegram")
  slackUserId String?
  createdAt   DateTime @default(now())
}

model TelegramUser {
  id         Int    @id @default(autoincrement())
  telegramId String @unique
  userId     Int
  user       User   @relation(fields: [userId], references: [id])
}

model SlackUser {
  id        Int    @id @default(autoincrement())
  slackId   String @unique
  userId    Int
  user      User   @relation(fields: [userId], references: [id])
}

model IncomeTaxCalcSetting {
  id                Int     @id @default(autoincrement())
  clientId          Int
  taxYear           String
  revenue           String?
  expense           String?
  income            String?
  useIncome         Boolean @default(false)
  startupRate       Int     @default(0)
  smeRate           Int     @default(0)
  investCredit      String?
  employmentCredit  String?
  extraExpense      String?
  fullData          String?  // 전체 설정 JSON
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([clientId, taxYear])
}

model TaxReductionCode {
  id              Int    @id @default(autoincrement())
  bizCode         String @unique  // 업종코드 6자리
  startupReduction String @default("X")  // 창중감 O/X
  smeReduction    String @default("X")  // 중특감 O/X
  categoryL       String?  // 대분류
  categoryM       String?  // 중분류
  categoryS       String?  // 소분류
  categoryD       String?  // 세분류
  categoryDD      String?  // 세세분류
}

model SettlementBookkeeping {
  id               Int      @id @default(autoincrement())
  yearMonth        String
  headquarterFee   Int      @default(0)
  withdrawn        Boolean  @default(false)
  remitted         Boolean  @default(false)
  tiIssued         Boolean  @default(false)
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  affiliation      String?
  assignedUserName String?
  ceoName          String?
  clientName       String
  createdByUserId  Int?
  monthlyFee       Int      @default(0)
  startMonth       String?
  checks           SettlementBookkeepingCheck[]
}

// 기장 정산 월별 체크 (출금/송금/T/I) — 거래처(기장) × 월 별로 분리 저장
model SettlementBookkeepingCheck {
  id              Int      @id @default(autoincrement())
  bookkeepingId   Int
  yearMonth       String
  withdrawn       Boolean  @default(false)
  remitted        Boolean  @default(false)
  tiIssued        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  bookkeeping     SettlementBookkeeping @relation(fields: [bookkeepingId], references: [id], onDelete: Cascade)

  @@unique([bookkeepingId, yearMonth])
}

model SettlementOneoff {
  id               Int      @id @default(autoincrement())
  yearMonth        String
  clientName       String
  ceoName          String?
  assignedUserName String?
  withdrawalAmount Int      @default(0)
  fee              Int      @default(0)
  withdrawn        Boolean  @default(false)
  remitted         Boolean  @default(false)
  tiIssued         Boolean  @default(false)
  notes            String?
  createdByUserId  Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  affiliation      String?
}

model SettlementRefund {
  id               Int      @id @default(autoincrement())
  yearMonth        String
  clientName       String
  ceoName          String?
  assignedUserName String?
  affiliation      String?
  withdrawalAmount Int      @default(0)
  fee              Int      @default(0)
  withdrawn        Boolean  @default(false)
  remitted         Boolean  @default(false)
  notes            String?
  createdByUserId  Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// 비품정산 — 공동 비품을 한 명이 결제 후 참여자끼리 N분의 1로 분배
model SettlementSupply {
  id              Int      @id @default(autoincrement())
  yearMonth       String
  item            String                       // 항목 (텍스트)
  amount          Int      @default(0)         // 금액
  payer           String                       // 결제자 (인원 중 1명)
  channel         String?                      // 결제채널 (텍스트)
  participants    String   @default("")        // 분배 대상 이름 CSV (체크된 사람)
  createdByUserId Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([yearMonth])
}

// 비품정산 월별 정산완료 체크 (사람 × 월)
model SettlementSupplySettled {
  id        Int      @id @default(autoincrement())
  yearMonth String
  person    String
  settled   Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@unique([yearMonth, person])
}

model UnpaidPostpone {
  id             Int      @id @default(autoincrement())
  clientId       Int      @unique
  postponedUntil DateTime
  note           String?
  createdAt      DateTime @default(now())
  client         Client   @relation(fields: [clientId], references: [id])
}

model TerminationProcess {
  id                Int       @id @default(autoincrement())
  clientId          Int       @unique
  startedAt         DateTime  @default(now())
  reason            String?
  ediSoloBiz        Boolean   @default(false)
  ediPensionDone    Boolean   @default(false)
  ediHealthDone     Boolean   @default(false)
  ediEmploymentDone Boolean   @default(false)
  cmsTerminated     Boolean   @default(false)
  semoReportTerminated Boolean @default(false)
  hometaxTerminated Boolean   @default(false)
  closureVat        String    @default("na")
  feeSeparate       Boolean   @default(false)
  feeAmount         Int?
  feePaid           Boolean   @default(false)
  notes             String?
  completedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  client            Client    @relation(fields: [clientId], references: [id])
}

model Feedback {
  id        Int      @id @default(autoincrement())
  authorId  Int
  category  String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  page      String?
  author    User     @relation("feedbacks", fields: [authorId], references: [id])
}

model Bookmark {
  id        Int      @id @default(autoincrement())
  scope     String   @default("shared")
  userId    Int?
  name      String
  keywords  String?
  url       String
  category  String?
  usageCount Int     @default(0)
  createdBy Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?    @relation("bookmarks", fields: [userId], references: [id])
  creator   User     @relation("createdBookmarks", fields: [createdBy], references: [id])
}
